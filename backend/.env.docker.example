DB_URL=jdbc:sqlserver://YOUR_DB_HOST:1433;databaseName=YOUR_DATABASE;encrypt=true;trustServerCertificate=false
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=CHANGE_ME
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
# Set true after configuring Gmail App Password:
MAIL_ENABLED=false
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD
JWT_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
# Optional R2 configuration if uploads use Cloudflare R2:
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PUBLIC_URL=

# Rasa on the same Docker network: http://rasa:5005
# Rasa on the Windows host (Docker Desktop): http://host.docker.internal:5005
RASA_BASE_URL=http://host.docker.internal:5005
RASA_AUTH_TOKEN=
RASA_TIMEOUT_SECONDS=60
